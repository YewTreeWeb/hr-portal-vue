    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.1.0",
    "@tailwindcss/vite": "^4.0.0-alpha.26",
    "tailwindcss": "^4.0.0-alpha.26",
    "dayjs": "^1.11.0",
    "idb": "^8.0.0",
