    "mapbox-gl": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.0",
